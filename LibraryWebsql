    ReservationID INT AUTO_INCREMENT PRIMARY KEY,
    ISBN VARCHAR(20) NOT NULL,
    Username VARCHAR(40) NOT NULL,
    ReservationDate DATE NOT NULL,
    FOREIGN KEY (Username) REFERENCES Users(Username) ON DELETE CASCADE,
